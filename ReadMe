# 基準日を親画面の初期状態へ戻す
st.session_state["search_base_type"] = st.session_state.get(
    "kensaku_kijunbi_mode",
    SEARCH_BASE_LATEST,
)

# radio/selectbox は次回描画前に初期化する
st.session_state["_reset_search_base_after_clear"] = True

# 検索結果側の基準年月日はクリア
st.session_state["_result_base_date"] = ""





# クリア押下後：基準日の表示状態を親画面の初期状態へ戻す
if st.session_state.pop("_reset_search_base_after_clear", False):

    initial_base_type = st.session_state.get(
        "kensaku_kijunbi_mode",
        SEARCH_BASE_LATEST,
    )

    st.session_state["search_base_type"] = initial_base_type

    if initial_base_type == SEARCH_BASE_LATEST:
        # 親画面が「最新」
        st.session_state["_search_base_radio"] = "最新"
        st.session_state["base_date"] = ""

    else:
        # 親画面が「月末・期末」
        st.session_state["_search_base_radio"] = "月末・期末"

        options = st.session_state.get("_base_date_options", [])

        parent_base_date = service.format_base_month(
            st.session_state.get("kensaku_kijunbi", "")
        )

        if parent_base_date and parent_base_date in options:
            st.session_state["base_date"] = parent_base_date
        elif options:
            st.session_state["base_date"] = options[0]
        else:
            st.session_state["base_date"] = ""
