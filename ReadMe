def on_search_base_change() -> None:
    st.session_state["_active_search_tab"] = "条件2 Condition2"

    label = st.session_state.get("_search_base_radio", "最新")

    if label == "月末・期末":
        st.session_state["search_base_type"] = SEARCH_BASE_MONTH_END

        options = st.session_state.get("_base_date_options", [])

        # 切回月末・期末时，优先恢复刚才手动选择过的日期
        last_base_date = st.session_state.get(
            "_last_month_end_base_date",
            ""
        )

        if last_base_date and last_base_date in options:
            st.session_state["base_date"] = last_base_date
        elif options:
            st.session_state["base_date"] = options[0]
        else:
            st.session_state["base_date"] = ""

    else:
        # 从月末・期末切换到最新之前，
        # 先把当前日期保存起来
        current_base_date = st.session_state.get("base_date", "")

        if current_base_date:
            st.session_state["_last_month_end_base_date"] = current_base_date

        st.session_state["search_base_type"] = SEARCH_BASE_LATEST
        st.session_state["base_date"] = ""




def on_base_date_change() -> None:
    st.session_state["_active_search_tab"] = "条件2 Condition2"

    st.session_state["_last_month_end_base_date"] = (
        st.session_state.get("base_date", "")
    )
