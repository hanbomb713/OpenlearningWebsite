if results:
    if st.session_state.get("search_base_type") == SEARCH_BASE_LATEST:
        first_row = results[0]

        if isinstance(first_row, dict):
            result_base_date = first_row.get("DATA_KIJUN_YMD", "")
        else:
            result_base_date = getattr(first_row, "DATA_KIJUN_YMD", "")

        result_base_date = str(result_base_date or "").strip()

        # 20260902 -> 2026/09/02
        if len(result_base_date) == 8 and result_base_date.isdigit():
            result_base_date = (
                f"{result_base_date[0:4]}/"
                f"{result_base_date[4:6]}/"
                f"{result_base_date[6:8]}"
            )

        st.session_state["_result_base_date"] = result_base_date



