def initialize_base_date_options(
    service: HojinNumberSearchService,
) -> None:

    current_options = st.session_state.get("_base_date_options", [])

    if (
        st.session_state.get("_base_date_initialized", False)
        and current_options
    ):
        return

    # DBから基準年月一覧取得
    base_date_rows = service.get_base_date_options()

    options = []

    for row in base_date_rows:

        value = None

        # Snowflake Row
        if hasattr(row, "as_dict"):
            row_dict = row.as_dict()
            value = row_dict.get("BASE_DATE")

        # dict
        elif isinstance(row, dict):
            value = row.get("BASE_DATE")

        # Row["BASE_DATE"]
        else:
            try:
                value = row["BASE_DATE"]
            except (KeyError, TypeError):
                try:
                    value = row[0]
                except (IndexError, TypeError):
                    value = None

        if value is not None:
            value = str(value).strip()

            if value and value not in options:
                options.append(value)

    # YYYY/MMなら文字列ソートでOK
    options.sort(reverse=True)

    st.session_state["_base_date_options"] = options

    # 親画面の基準年月
    parent_base_date = service.format_base_month(
        st.session_state.get("kensaku_kijunbi", "")
    )

    # 初期選択値
    if parent_base_date in options:
        st.session_state["base_date"] = parent_base_date

    elif options:
        st.session_state["base_date"] = options[0]

    else:
        st.session_state["base_date"] = ""

    st.session_state["_base_date_initialized"] = True
