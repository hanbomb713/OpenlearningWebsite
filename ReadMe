INSERT INTO MAIN_H.SILVER_4.T456SMDD010
WITH SRC AS (
    SELECT *
    FROM MAIN_H.SILVER_4.T456SMDD010
    WHERE HOJIN_NO = '232003'
    QUALIFY ROW_NUMBER() OVER (
        ORDER BY KIJUN_YMD DESC
    ) = 1
)
SELECT * REPLACE (
    '555001' AS HOJIN_NO,
    '955001' AS NAYOSE_HOJIN_NO,
    '955002' AS TOP_CO_HOJIN_NO,
    '955003' AS OYA_CO_HOJIN_NO,
    'テスト全法人５５５００１' AS KANJI_FULL_NAME
)
FROM SRC

UNION ALL

SELECT * REPLACE (
    '555002' AS HOJIN_NO,
    '555002' AS NAYOSE_HOJIN_NO,
    '955012' AS TOP_CO_HOJIN_NO,
    '955013' AS OYA_CO_HOJIN_NO,
    'テスト名寄法人５５５００２' AS KANJI_FULL_NAME
)
FROM SRC

UNION ALL

SELECT * REPLACE (
    '555003' AS HOJIN_NO,
    '955021' AS NAYOSE_HOJIN_NO,
    '555003' AS TOP_CO_HOJIN_NO,
    '955023' AS OYA_CO_HOJIN_NO,
    'テスト頂点法人５５５００３' AS KANJI_FULL_NAME
)
FROM SRC

UNION ALL

SELECT * REPLACE (
    '555004' AS HOJIN_NO,
    '955031' AS NAYOSE_HOJIN_NO,
    '955032' AS TOP_CO_HOJIN_NO,
    '555004' AS OYA_CO_HOJIN_NO,
    'テスト親法人５５５００４' AS KANJI_FULL_NAME
)
FROM SRC;





INSERT INTO MAIN_H.SILVER_4.T456SMDD020
WITH SRC AS (
    SELECT *
    FROM MAIN_H.SILVER_4.T456SMDD020
    WHERE KIJUN_YMD = (
        SELECT MAX(KIJUN_YMD)
        FROM MAIN_H.SILVER_4.T456SMDD010
    )
    QUALIFY ROW_NUMBER() OVER (
        ORDER BY HOJIN_NO, MEIGI_NO
    ) = 1
)
SELECT * REPLACE (
    '555001' AS HOJIN_NO,
    '5555550001' AS MEIGI_NO
)
FROM SRC

UNION ALL

SELECT * REPLACE (
    '555002' AS HOJIN_NO,
    '5555550002' AS MEIGI_NO
)
FROM SRC

UNION ALL

SELECT * REPLACE (
    '555003' AS HOJIN_NO,
    '5555550003' AS MEIGI_NO
)
FROM SRC

UNION ALL

SELECT * REPLACE (
    '555004' AS HOJIN_NO,
    '5555550004' AS MEIGI_NO
)
FROM SRC;




SELECT
    HOJIN_NO,
    NAYOSE_HOJIN_NO,
    TOP_CO_HOJIN_NO,
    OYA_CO_HOJIN_NO,
    KANJI_FULL_NAME,
    KIJUN_YMD
FROM MAIN_H.SILVER_4.T456SMDD010
WHERE HOJIN_NO IN ('555001', '555002', '555003', '555004')
ORDER BY HOJIN_NO;




SELECT
    HOJIN_NO,
    MEIGI_NO,
    KIJUN_YMD
FROM MAIN_H.SILVER_4.T456SMDD020
WHERE MEIGI_NO IN (
    '5555550001',
    '5555550002',
    '5555550003',
    '5555550004'
)
ORDER BY MEIGI_NO;
