def sync_parent_base_date_state() -> None:
    # 父画面的实际 radio
    parent_radio = st.session_state.get("gld11_date_radio_ui", "")

    # 父画面的实际年月 selectbox
    parent_base_date = st.session_state.get("gld11_kijunbi_ym_ui", "")

    # 如果能取得父画面的控件状态，优先以控件状态为准
    if parent_radio:
        if "月末" in str(parent_radio) or "期末" in str(parent_radio):
            st.session_state["search_base_type"] = SEARCH_BASE_MONTH_END
            st.session_state["_search_base_radio"] = "月末・期末"

            formatted = HojinNumberSearchService.format_base_month(
                parent_base_date
            )
            st.session_state["base_date"] = formatted

        else:
            st.session_state["search_base_type"] = SEARCH_BASE_LATEST
            st.session_state["_search_base_radio"] = "最新"
            st.session_state["base_date"] = ""

        return

    # 父控件key取不到时，才使用原来的传递值
    search_base_type = st.session_state.get(
        "kensaku_kijunbi_mode",
        SEARCH_BASE_LATEST,
    )

    st.session_state["search_base_type"] = search_base_type

    if search_base_type == SEARCH_BASE_MONTH_END:
        st.session_state["_search_base_radio"] = "月末・期末"
        st.session_state["base_date"] = (
            HojinNumberSearchService.format_base_month(
                st.session_state.get("kensaku_kijunbi", "")
            )
        )
    else:
        st.session_state["_search_base_radio"] = "最新"
        st.session_state["base_date"] = ""




init_session_state()

st.session_state[SESSION_KEY.SS_KEY_GAMEN_NAME] = "法人DM 法人番号検索"
service = create_service()

if not st.session_state.get("_master_initialized", False):
    with st.spinner("..."):
        initialize_master_data(service)
else:
    initialize_master_data(service)

initialize_base_date_options(service)

# ★ 每次打开Popup，都重新读取父画面的当前基準日状态
sync_parent_base_date_state()

render_filter_area(service)
