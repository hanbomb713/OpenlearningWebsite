def sync_parent_base_date_state() -> None:
    # popup打开后只从父画面同步一次
    if st.session_state.get("_search_base_initialized", False):
        return

    # -----------------------------
    # GLD11父画面判定
    # -----------------------------
    is_gld11_parent = (
        "gld11_date_radio" in st.session_state
        or "gld11_kijunbi_ym" in st.session_state
    )

    if is_gld11_parent:
        # GLD11允许子画面手动切换 最新 / 月末・期末
        st.session_state["_allow_month_end"] = True

        # ★ 父画面已经把最终值放到这两个key里
        parent_mode = st.session_state.get("kensaku_kijunbi_mode")
        parent_base_date = st.session_state.get("kensaku_kijunbi", "")

        # ★ 父画面是「最新」时，kensaku_kijunbi一定为空
        if not parent_base_date:
            st.session_state["search_base_type"] = SEARCH_BASE_LATEST
            st.session_state["_search_base_radio"] = "最新"
            st.session_state["base_date"] = ""
            st.session_state["_result_base_date"] = ""

        # ★ 有年月就是「月末・期末」
        else:
            st.session_state["search_base_type"] = SEARCH_BASE_MONTH_END
            st.session_state["_search_base_radio"] = "月末・期末"

            st.session_state["base_date"] = (
                HojinNumberSearchService.format_base_month(
                    parent_base_date
                )
            )

            st.session_state["_result_base_date"] = ""

    else:
        # 另一个父画面：只允许最新
        st.session_state["_allow_month_end"] = False
        st.session_state["search_base_type"] = SEARCH_BASE_LATEST
        st.session_state["_search_base_radio"] = "最新"
        st.session_state["base_date"] = ""
        st.session_state["_result_base_date"] = ""

    st.session_state["_search_base_initialized"] = True
