WITH common_cols AS (
    SELECT
        m.COLUMN_NAME,
        m.ORDINAL_POSITION
    FROM MAIN_H.INFORMATION_SCHEMA.COLUMNS m
    INNER JOIN MAIN_H.INFORMATION_SCHEMA.COLUMNS d
        ON m.COLUMN_NAME = d.COLUMN_NAME
    WHERE m.TABLE_SCHEMA = 'SILVER_4'
      AND m.TABLE_NAME = 'T456SMMD010'
      AND d.TABLE_SCHEMA = 'SILVER_4'
      AND d.TABLE_NAME = 'T456SMDD010'
      AND m.COLUMN_NAME <> 'KIJUN_YM'
)
SELECT
    'INSERT INTO MAIN_H.SILVER_4.T456SMMD010 (KIJUN_YM, '
    || LISTAGG(COLUMN_NAME, ', ')
       WITHIN GROUP (ORDER BY ORDINAL_POSITION)
    || ') SELECT ''202609'', '
    || LISTAGG(COLUMN_NAME, ', ')
       WITHIN GROUP (ORDER BY ORDINAL_POSITION)
    || ' FROM MAIN_H.SILVER_4.T456SMDD010'
    || ' WHERE HOJIN_NO = ''666004'''
    || ' AND KIJUN_YMD = ''20260902'''
    || ' AND NOT EXISTS ('
    || 'SELECT 1 FROM MAIN_H.SILVER_4.T456SMMD010'
    || ' WHERE HOJIN_NO = ''666004'''
    || ' AND KIJUN_YM = ''202609'');'
    AS INSERT_SQL
FROM common_cols;
