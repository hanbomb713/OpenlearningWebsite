
# 共通：Master 数据查询（缓存）
@st.cache_data(show_spinner=False, ttl=3600)
def _get_master_data_cached(
    _self, sql_name: str
) -> list[Any]:
    rows = _self.runner.query(sql_name, {})

    if rows is None:
        raise RuntimeError(f"SQL query failed: {sql_name}")

    return rows.collect()


# 共通：缓存外处理错误和消息
def _get_master_options(self, sql_name: str) -> list[Any]:
    try:
        result = self._get_master_data_cached(sql_name)
    except Exception:
        st.session_state.pop(
            SESSION_KEY.SS_KEY_DB_ERROR, None
        )
        msg_util.push_messages("456ERR0064")
        return []

    error_msg = st.session_state.pop(
        SESSION_KEY.SS_KEY_DB_ERROR, None
    )

    if error_msg:
        msg_util.push_messages("456ERR0064")
        return []

    return result


# 四个 Master 取得方法维持不变
def get_theme_options(self) -> list[Any]:
    return self._get_master_options(MASTER_SQL_THEME)

def get_branch_options(self) -> list[Any]:
    return self._get_master_options(MASTER_SQL_BRANCH)

def get_boj_industry_options(self) -> list[Any]:
    return self._get_master_options(MASTER_SQL_BOJ_INDUSTRY)

def get_base_date_options(self) -> list[Any]:
    return self._get_master_options(MASTER_SQL_BASE_DATE)
