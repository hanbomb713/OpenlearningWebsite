
-- ITb_40 変更候補一覧
-- 日次・月次の法人番号登録済みデータを取得

SELECT
    '日次' AS DATA_SOURCE,
    KIJUN_YMD AS KIJUN,
    MEIGARA_CD,
    KANRI_TEMBAN,
    HOJIN_NO,
    TOSHI_KBN,
    MGN,
    BOKA_ZD_YEN
FROM MAIN_K.SILVER.T456SMDA030
WHERE KIJUN_YMD <= '20260606'
  AND RONRI_SAKUJO_FLG = '0'
  AND HOJINDM_KAMOKU_CD = 'BOND'
  AND SHUBETSU IN ('国内債券', '国内外国債券')
  AND NULLIF(TRIM(HOJIN_NO), '') IS NOT NULL
  AND TRIM(HOJIN_NO) <> '000000'

UNION ALL

SELECT
    '月次' AS DATA_SOURCE,
    KIJUN_YM AS KIJUN,
    MEIGARA_CD,
    KANRI_TEMBAN,
    HOJIN_NO,
    TOSHI_KBN,
    MGN,
    BOKA_ZD_YEN
FROM MAIN_K.SILVER.T456SMMA030
WHERE KIJUN_YM = '202605'
  AND RONRI_SAKUJO_FLG = '0'
  AND HOJINDM_KAMOKU_CD = 'BOND'
  AND SHUBETSU IN ('国内債券', '国内外国債券')
  AND NULLIF(TRIM(HOJIN_NO), '') IS NOT NULL
  AND TRIM(HOJIN_NO) <> '000000'

ORDER BY DATA_SOURCE, KIJUN DESC, MEIGARA_CD;
